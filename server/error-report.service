[Unit]
Description=Count the bookshop's errors into a daily report

[Service]
Type=oneshot
User=reporter
Group=reporter
Environment=LOG_DIR=/srv/bookshop/logs OUT_DIR=/srv/reports LOCK=/run/lock/error-report.lock
ExecStart=/usr/local/bin/error-report
# Runs after every run, however it ended, and tells Healthchecks.io how.
ExecStopPost=/usr/local/bin/hc-ping
# A run that takes longer than this is killed, and counts as a failure.
TimeoutStartSec=2min

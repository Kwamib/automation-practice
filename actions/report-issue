#!/usr/bin/env bash
# report-issue: keep one GitHub issue open while links are broken.
#
#   report-issue open REPORT   open an issue with the report, or comment on the open one
#   report-issue close         close the open issue, since every link works again
#
# Uses the gh command, which reads GH_TOKEN and GH_REPO from the environment.
set -euo pipefail

LABEL=${LABEL:-broken-links}
open=$(gh issue list --label "$LABEL" --state open --json number --jq '.[0].number // empty')

case "${1:-}" in
	open)
		report=${2:?usage: report-issue open REPORT}
		if [ -n "$open" ]; then
			gh issue comment "$open" --body-file "$report"
			echo "Still broken: commented on issue #$open"
		else
			gh label create "$LABEL" --color D93F0B --description "Found by the nightly link check" --force
			gh issue create --title "Broken links found by the nightly check" --label "$LABEL" --body-file "$report"
		fi
		;;
	close)
		if [ -n "$open" ]; then
			gh issue close "$open" --comment "Every link works again (run ${GITHUB_RUN_ID:-by hand}). Closing."
			echo "Fixed: closed issue #$open"
		else
			echo "No open issue to close"
		fi
		;;
	*)
		echo "usage: report-issue open REPORT | report-issue close" >&2
		exit 2
		;;
esac

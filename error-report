#!/usr/bin/env bash
# error-report: count each distinct error in the bookshop's app logs, most frequent first.
#
# Safe to run unattended:
#   - one copy at a time: a second run while one is going skips itself (flock)
#   - a time limit on the scan, so a stuck disk can't hang it forever (timeout)
#   - --dry-run prints the report without writing anything
#   - the report is either complete or not there at all (write to a temp file, then mv)
#   - exit codes say what happened: 0 done or skipped, 1 failed, 2 wrong usage
#
# Settings come from the environment, with defaults for the practice folder:
#   LOG_DIR  where the logs are          (default: ./logs)
#   OUT_DIR  where reports are written   (default: ./reports)
#   LIMIT    seconds the scan may take   (default: 60)
#   LOCK     the lock file               (default: /tmp/error-report.lock)
set -euo pipefail

LOG_DIR=${LOG_DIR:-./logs}
OUT_DIR=${OUT_DIR:-./reports}
LIMIT=${LIMIT:-60}
LOCK=${LOCK:-/tmp/error-report.lock}
DRY_RUN=0

log() { printf '%s error-report: %s\n' "$(date -u +%FT%TZ)" "$*" >&2; }
usage() { echo "usage: error-report [--dry-run]" >&2; exit 2; }

case "${1:-}" in
	"") ;;
	--dry-run) DRY_RUN=1 ;;
	*) usage ;;
esac
[ $# -le 1 ] || usage

# One copy at a time. File descriptor 9 holds the lock until the script exits.
exec 9>"$LOCK"
if ! flock -n 9; then
	log "another run is still going; skipping this one"
	exit 0
fi

[ -d "$LOG_DIR" ] || { log "no log folder at $LOG_DIR"; exit 1; }

lines=$(mktemp)
counts=$(mktemp)
trap 'rm -f "$lines" "$counts"' EXIT

# The scan, with a time limit. -print0 and xargs -0 handle any file name, spaces
# included. grep -i catches ERROR and error; -w skips words like errors_total.
# grep exits 1 when a file has no match, which is fine here; only 2 (it couldn't
# read a file) counts as a failure.
export LOG_DIR
set +e
timeout "$LIMIT" bash -c '
	set -o pipefail
	find "$LOG_DIR" -type f -name "app.txt" -print0 \
	| xargs -0 -r sh -c '\''grep -ihw -- error "$@"; [ $? -le 1 ]'\'' sh
' >"$lines"
rc=$?
set -e
case $rc in
	0) ;;
	124) log "the scan took longer than ${LIMIT}s; no report this time"; exit 1 ;;
	*) log "the scan failed (exit code $rc); no report this time"; exit 1 ;;
esac

# Drop the date, time and level, so the same message at different times is the
# same line; then count each one, most frequent first.
sed -E 's/^[^ ]+ [^ ]+ [^ ]+ +//' "$lines" | sort | uniq -c | sort -rn >"$counts"

found=$(wc -l <"$lines")
kinds=$(wc -l <"$counts")
day=$(date -u +%F)
report="$OUT_DIR/errors-$day.txt"

if [ "$DRY_RUN" -eq 1 ]; then
	log "dry run: $found lines, $kinds kinds of error; would write $report"
	cat "$counts"
	exit 0
fi

mkdir -p "$OUT_DIR"
if [ -f "$report" ] && cmp -s "$counts" "$report"; then
	log "$report is already up to date ($found lines, $kinds kinds)"
	exit 0
fi

# Write next to the report, then rename: a rename on the same disk is all or
# nothing, so nobody ever reads a half-written report.
tmp=$(mktemp "$OUT_DIR/.errors-XXXXXX")
cp "$counts" "$tmp"
chmod 644 "$tmp"
mv -f "$tmp" "$report"
log "wrote $report ($found lines, $kinds kinds of error)"

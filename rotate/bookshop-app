#!/usr/bin/env python3
"""bookshop-app: a stand-in for the bookshop's web app, on port 8080.

  /books   how many books are in the database, and which login it used
  /health  200 if the app can read from the database, 503 if not

It reads its database login from /etc/bookshop/db.env when it starts, and
keeps one connection open, as real apps do. When it gets SIGHUP (systemctl
reload), it reads the file again, logs in with the new login first, and only
switches over if that works: no request ever sees a gap.
"""
import http.server
import signal
import threading

import psycopg2

ENV_FILE = "/etc/bookshop/db.env"
lock = threading.Lock()
conn = None
login = {}


def log(msg):
    print(msg, flush=True)


def read_env():
    env = {}
    with open(ENV_FILE) as f:
        for line in f:
            key, _, value = line.strip().partition("=")
            if key and not key.startswith("#"):
                env[key] = value
    return env


def connect(env):
    c = psycopg2.connect(host="127.0.0.1", dbname="bookshop", user=env["DB_USER"],
                         password=env["DB_PASSWORD"], application_name="bookshop-app",
                         connect_timeout=3)
    c.autocommit = True
    with c.cursor() as cur:
        cur.execute("SELECT count(*) FROM books")
    return c


def load():
    """Log in with whatever db.env says now; switch only if it works."""
    global conn, login
    try:
        env = read_env()
        new = connect(env)
    except Exception as e:
        log(f"can't log in to the database: {str(e).strip()}; keeping the current connection")
        return
    with lock:
        old, conn, login = conn, new, env
    if old is not None:
        old.close()
    log(f"connected to the database as {env['DB_USER']}")


def count_books():
    """Read from the database. If the connection has dropped, log in again
    with the login the app already has (not the file: that's only read at
    start and on reload)."""
    global conn
    with lock:
        for attempt in (1, 2):
            try:
                if conn is None:
                    conn = connect(login)
                with conn.cursor() as cur:
                    cur.execute("SELECT count(*) FROM books")
                    return cur.fetchone()[0]
            except Exception as e:
                conn = None
                if attempt == 2:
                    raise e


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path not in ("/books", "/health"):
            self.send_response(404)
            self.end_headers()
            return
        try:
            n = count_books()
            code, body = 200, f"{n} books (database login: {login.get('DB_USER')})\n"
        except Exception as e:
            code, body = 503, f"can't reach the database: {str(e).strip().splitlines()[0]}\n"
        self.send_response(code)
        self.send_header("Content-Type", "text/plain")
        self.end_headers()
        self.wfile.write(body.encode())

    def log_message(self, *args):
        pass


def main():
    global login
    login = read_env()
    try:
        load_first = connect(login)
        globals()["conn"] = load_first
        log(f"connected to the database as {login['DB_USER']}")
    except Exception as e:
        log(f"can't log in to the database as {login.get('DB_USER')}: {str(e).strip()}")
    signal.signal(signal.SIGHUP, lambda *_: threading.Thread(target=load).start())
    http.server.ThreadingHTTPServer(("127.0.0.1", 8080), Handler).serve_forever()


if __name__ == "__main__":
    main()
